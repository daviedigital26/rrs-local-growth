{
  "meta": {
    "name": "Reale Revenue Systems design tokens",
    "version": "1.0.0",
    "source": "Master Build Prompt Part 1.2 + RRS master brand system",
    "note": "Source of truth. Run `npm run tokens` to regenerate tokens.css and tokens.ts. Derived colours are mixes of brand colours only, so they always stay inside the palette."
  },
  "color": {
    "brand": {
      "ink": { "value": "#081020", "name": "Midnight Ink", "role": "Primary dark background; authority" },
      "cobalt": { "value": "#4F5DFF", "name": "Electric Cobalt", "role": "Primary action; process emphasis" },
      "mint": { "value": "#2DD4BF", "name": "Signal Mint", "role": "Recovered opportunity; positive signal; CTA accent only (≤5%)" },
      "slate": { "value": "#334155", "name": "Slate", "role": "Secondary text; rules; supporting UI" },
      "canvas": { "value": "#F7F4EE", "name": "Warm Canvas", "role": "Primary light background" },
      "white": { "value": "#FFFFFF", "name": "Pure White", "role": "High-contrast text on dark; cards" }
    },
    "derived": {
      "ink-900": { "mix": ["ink", "white", 0.0], "role": "Page background (dark)" },
      "ink-800": { "mix": ["ink", "cobalt", 0.06], "role": "Raised dark surface" },
      "ink-700": { "mix": ["ink", "cobalt", 0.14], "role": "Dark card / glass base" },
      "ink-600": { "mix": ["ink", "cobalt", 0.24], "role": "Dark borders, hover" },
      "cobalt-700": { "mix": ["cobalt", "ink", 0.30], "role": "Link + emphasis text on light; button hover" },
      "cobalt-600": { "mix": ["cobalt", "ink", 0.14], "role": "Button pressed" },
      "cobalt-300": { "mix": ["cobalt", "white", 0.42], "role": "Link + emphasis text on dark" },
      "cobalt-100": { "mix": ["cobalt", "white", 0.86], "role": "Tint backgrounds on light" },
      "cobalt-050": { "mix": ["cobalt", "canvas", 0.94], "role": "Subtle tint on canvas" },
      "mint-200": { "mix": ["mint", "white", 0.55], "role": "Mint text on dark (small)" },
      "mint-100": { "mix": ["mint", "white", 0.84], "role": "Positive tint on light" },
      "mint-800": { "mix": ["mint", "ink", 0.62], "role": "Positive text on light (accessible)" },
      "slate-700": { "mix": ["slate", "ink", 0.35], "role": "Body text on light" },
      "slate-400": { "mix": ["slate", "white", 0.42], "role": "Muted icons/borders on light" },
      "slate-200": { "mix": ["slate", "canvas", 0.82], "role": "Hairlines on canvas" },
      "fog": { "mix": ["white", "slate", 0.30], "role": "Muted text on dark" },
      "canvas-200": { "mix": ["canvas", "slate", 0.06], "role": "Sunken light surface" }
    }
  },
  "font": {
    "display": "'Inter Display', 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "body": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "size": {
    "xs": "0.8125rem",
    "sm": "0.9375rem",
    "base": "1.0625rem",
    "lg": "1.1875rem",
    "xl": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
    "2xl": "clamp(1.5rem, 1.25rem + 1vw, 1.875rem)",
    "3xl": "clamp(1.875rem, 1.45rem + 1.8vw, 2.625rem)",
    "4xl": "clamp(2.25rem, 1.6rem + 2.8vw, 3.5rem)",
    "5xl": "clamp(2.5rem, 1.6rem + 3.9vw, 4.5rem)"
  },
  "leading": { "tight": "1.08", "snug": "1.22", "normal": "1.55", "relaxed": "1.7" },
  "tracking": { "tight": "-0.025em", "snug": "-0.012em", "normal": "0", "caps": "0.08em" },
  "space": {
    "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem",
    "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem", "20": "5rem", "24": "6rem",
    "section": "clamp(4rem, 2.5rem + 6vw, 8rem)",
    "gutter": "clamp(1.125rem, 0.6rem + 2.2vw, 2rem)"
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "18px", "xl": "28px", "pill": "999px" },
  "shadow": {
    "card": "0 1px 2px rgba(8,16,32,0.06), 0 10px 30px -12px rgba(8,16,32,0.14)",
    "raised": "0 2px 4px rgba(8,16,32,0.08), 0 24px 60px -20px rgba(8,16,32,0.28)",
    "glow": "0 0 0 1px rgba(79,93,255,0.35), 0 18px 50px -18px rgba(79,93,255,0.6)",
    "inset-dark": "inset 0 1px 0 rgba(255,255,255,0.06)"
  },
  "motion": {
    "fast": "140ms",
    "base": "220ms",
    "slow": "480ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  },
  "layout": { "max": "1200px", "prose": "68ch", "header": "68px" },
  "breakpoint": { "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "contrast": {
    "note": "Approved text/background pairs. tokens.test.ts verifies every pair against WCAG 2.2.",
    "pairs": [
      { "fg": "white", "bg": "ink", "min": 7, "use": "Headings/body on dark" },
      { "fg": "fog", "bg": "ink", "min": 4.5, "use": "Muted text on dark" },
      { "fg": "cobalt-300", "bg": "ink", "min": 4.5, "use": "Links on dark" },
      { "fg": "mint", "bg": "ink", "min": 4.5, "use": "Positive accent text on dark" },
      { "fg": "mint-200", "bg": "ink-700", "min": 4.5, "use": "Positive text on dark cards" },
      { "fg": "white", "bg": "ink-700", "min": 7, "use": "Text on dark cards" },
      { "fg": "fog", "bg": "ink-700", "min": 4.5, "use": "Muted text on dark cards" },
      { "fg": "white", "bg": "cobalt", "min": 4.5, "use": "Primary button" },
      { "fg": "white", "bg": "cobalt-700", "min": 4.5, "use": "Primary button hover" },
      { "fg": "ink", "bg": "mint", "min": 4.5, "use": "Mint badge" },
      { "fg": "ink", "bg": "canvas", "min": 7, "use": "Headings on light" },
      { "fg": "slate-700", "bg": "canvas", "min": 7, "use": "Body on light" },
      { "fg": "slate", "bg": "canvas", "min": 4.5, "use": "Secondary text on light" },
      { "fg": "slate", "bg": "white", "min": 4.5, "use": "Secondary text on cards" },
      { "fg": "cobalt-700", "bg": "canvas", "min": 4.5, "use": "Links on light" },
      { "fg": "cobalt-700", "bg": "white", "min": 4.5, "use": "Links on cards" },
      { "fg": "cobalt-700", "bg": "cobalt-100", "min": 4.5, "use": "Chip selected (light)" },
      { "fg": "mint-800", "bg": "mint-100", "min": 4.5, "use": "Positive badge (light)" },
      { "fg": "mint-800", "bg": "white", "min": 4.5, "use": "Positive text on cards" },
      { "fg": "mint", "bg": "ink", "min": 3, "use": "Focus ring on dark (non-text)" },
      { "fg": "cobalt", "bg": "canvas", "min": 3, "use": "Focus ring / UI on light (non-text)" }
    ]
  }
}
