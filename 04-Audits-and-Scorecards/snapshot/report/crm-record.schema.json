{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reale-revenue-systems/schemas/crm-snapshot-record-1.json",
  "title": "RRS CRM Snapshot record v1",
  "description": "Import shape for Reale OS / any CRM. Scores stay separate; ICP fit and outreach priority are filled by the Phase 3 engine, never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "record_type", "fictional", "company_name", "business_category", "service_area", "website", "public_business_phone", "contact", "dedupe_key", "scores", "opportunity_categories", "proposed_service", "proposed_service_id", "estimated_deal_value", "evidence", "research_notes", "lead_source", "outreach_status", "next_action", "report_date", "framework_version"],
  "properties": {
    "schema": { "const": "rrs.crm.snapshot-record/1" },
    "record_type": { "const": "snapshot_audit" },
    "fictional": { "type": "boolean" },
    "company_name": { "type": "string", "minLength": 1 },
    "business_category": { "type": "string" },
    "service_area": { "type": "string" },
    "website": { "type": ["string", "null"] },
    "public_business_phone": { "type": ["string", "null"] },
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["name", "email", "phone"],
      "properties": { "name": { "type": ["string", "null"] }, "email": { "type": ["string", "null"] }, "phone": { "type": ["string", "null"] } }
    },
    "dedupe_key": { "type": "string", "pattern": "^(domain|name):" },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_verified_score", "snapshot_coverage_pct", "research_confidence", "icp_fit", "outreach_priority", "categories"],
      "properties": {
        "snapshot_verified_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "snapshot_coverage_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "research_confidence": { "enum": ["high", "medium", "low", "insufficient"] },
        "icp_fit": { "type": "null" },
        "outreach_priority": { "type": "null" },
        "categories": {
          "type": "object",
          "required": ["maps", "ai", "reviews", "website", "followup"],
          "additionalProperties": false,
          "patternProperties": {
            "^(maps|ai|reviews|website|followup)$": {
              "type": "object", "additionalProperties": false, "required": ["score_out_of_20", "confidence", "not_verified"],
              "properties": {
                "score_out_of_20": { "type": ["number", "null"], "minimum": 0, "maximum": 20 },
                "confidence": { "enum": ["high", "medium", "low", "insufficient"] },
                "not_verified": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "opportunity_categories": { "type": "array", "items": { "enum": ["maps", "ai", "reviews", "website", "followup"] } },
    "proposed_service": { "type": ["string", "null"] },
    "proposed_service_id": { "type": ["string", "null"] },
    "estimated_deal_value": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["setup", "monthly", "price_status"], "properties": { "setup": { "type": "number" }, "monthly": { "type": "number" }, "price_status": { "enum": ["proposed", "approved"] } } }
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["sources", "not_verified_items", "last_verified", "overrides"],
      "properties": { "sources": { "type": "integer" }, "not_verified_items": { "type": "integer" }, "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }, "overrides": { "type": "integer" } }
    },
    "research_notes": { "type": "string" },
    "lead_source": { "type": ["string", "null"] },
    "outreach_status": { "enum": ["not_contacted"] },
    "next_action": { "type": "string" },
    "report_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "framework_version": { "type": "string" }
  }
}
