# Reale Revenue Systems — website configuration
# Copy to .env (never commit .env). Every value is optional: when unset the
# related feature stays OFF and the site runs in safe preview mode.

# Canonical origin used for canonical tags, sitemap and Open Graph URLs.
# Placeholder until a domain is approved and purchased.
SITE_URL=https://www.example-rrs-domain.com

# Form submission endpoint (e.g. an n8n webhook URL). Unset = forms validate
# but do NOT send anything; the visitor sees a "preview mode" notice.
# REQUIRES: n8n instance (self-hosted or n8n Cloud — paid) and your approval.
FORM_ENDPOINT=

# Booking link (e.g. Cal.com event URL). Unset = booking buttons are hidden.
# REQUIRES: Cal.com account (free tier available) and your approval.
BOOKING_URL=

# Analytics. Unset = no analytics script is loaded at all.
# Options: "plausible" (paid, cookieless) or "ga4" (free, needs consent banner).
ANALYTICS_PROVIDER=
ANALYTICS_ID=

# Error monitoring endpoint (e.g. Sentry DSN or n8n webhook). Unset = off.
ERROR_ENDPOINT=

# Public business contact details shown on the site. Leave blank until approved.
PUBLIC_PHONE=
PUBLIC_EMAIL=
